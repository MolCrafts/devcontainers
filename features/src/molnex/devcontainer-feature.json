{
  "id": "molnex",
  "version": "1.0.1",
  "name": "MolCrafts molnex",
  "description": "Meta-feature for molnex: scikit-build-core + cmake>=4 + ninja for the compiled torch ops, and uv resolution wired to the right PyTorch wheel index. Composition only \u2014 torch itself comes from the project's own lockfile.",
  "documentationURL": "https://github.com/MolCrafts/devcontainers/tree/master/features/src/molnex",
  "licenseURL": "https://github.com/MolCrafts/devcontainers/blob/master/LICENSE",
  "keywords": [
    "molnex",
    "meta",
    "pytorch",
    "cuda",
    "cmake"
  ],
  "dependsOn": {
    "ghcr.io/molcrafts/devcontainers/python:1": {
      "pythonVersion": "3.14",
      "tools": "ruff,ty,prek"
    },
    "ghcr.io/molcrafts/devcontainers/native:1": {
      "cmakeVersion": "latest",
      "installDoxygen": false
    },
    "ghcr.io/molcrafts/devcontainers/torch:1": {
      "backend": "auto",
      "buildIsolation": false
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-toolsai.jupyter",
        "nvidia.nsight-vscode-edition"
      ]
    }
  }
}
