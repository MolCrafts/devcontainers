{
    "name": "molnex",
    "id": "molnex",
    "version": "0.0.1",
    "description": "ML development environment configuration for PyTorch-based projects (requires base image with PyTorch)",
    "licenseURL": "https://github.com/MolCrafts/devcontainers/blob/main/LICENSE",
    "dependsOn": {},
    "containerEnv": {
        "PATH": "/usr/local/cuda/bin:${PATH}",
        "LD_LIBRARY_PATH": "/usr/local/cuda/lib64:${LD_LIBRARY_PATH}"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "charliermarsh.ruff"
            ]
        }
    },
    "options": {
        "backend": {
            "type": "string",
            "enum": [
                "cpu",
                "cuda"
            ],
            "default": "cpu",
            "description": "PyTorch compute backend (informational only - PyTorch must be provided by base image)"
        }
    }
}