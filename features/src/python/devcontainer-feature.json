{
  "id": "python",
  "version": "1.0.2",
  "name": "MolCrafts Python toolchain",
  "description": "uv-managed Python toolchain shared by every MolCrafts Python repo: uv, a uv-managed CPython, plus ruff / ty / prek installed as isolated uv tools.",
  "documentationURL": "https://github.com/MolCrafts/devcontainers/tree/master/features/src/python",
  "licenseURL": "https://github.com/MolCrafts/devcontainers/blob/master/LICENSE",
  "keywords": [
    "python",
    "uv",
    "ruff",
    "ty",
    "prek"
  ],
  "options": {
    "uvVersion": {
      "type": "string",
      "proposals": [
        "latest",
        "0.9.7"
      ],
      "default": "latest",
      "description": "uv release to install. 'latest' tracks the newest published release."
    },
    "pythonVersion": {
      "type": "string",
      "proposals": [
        "3.14",
        "3.13",
        "3.12",
        "none"
      ],
      "default": "3.14",
      "description": "uv-managed CPython to pre-install into the shared interpreter directory. 'none' installs no interpreter and leaves whatever the base image provides."
    },
    "tools": {
      "type": "string",
      "default": "ruff,ty,prek",
      "description": "Comma-separated PyPI tools installed with 'uv tool install' into a shared, remote-user-writable tool directory. Set to 'none' to skip."
    }
  },
  "containerEnv": {
    "UV_LINK_MODE": "copy",
    "UV_PYTHON_INSTALL_DIR": "/usr/local/share/uv/python",
    "UV_TOOL_DIR": "/usr/local/share/uv/tools",
    "UV_TOOL_BIN_DIR": "/usr/local/share/uv/bin"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "charliermarsh.ruff",
        "ms-python.python",
        "ms-python.debugpy",
        "njpwerner.autodocstring",
        "tamasfe.even-better-toml"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "python.terminal.activateEnvInCurrentTerminal": true,
        "python.testing.pytestEnabled": true,
        "python.testing.unittestEnabled": false,
        "python.analysis.typeCheckingMode": "off",
        "ruff.nativeServer": "on",
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
          }
        }
      }
    }
  },
  "installsAfter": [
    "ghcr.io/devcontainers/features/common-utils"
  ]
}
