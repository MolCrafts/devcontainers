{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json",
  "name": "MolCrafts CUDA",

  // Same base as molcrafts-cpu; the CUDA toolkit is layered on as a feature so
  // the two images stay one diff apart instead of one being a vendor image.
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",

  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": true,
      "upgradePackages": true
    },
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/node:1": { "version": "22" },

    // nvcc + cuDNN + NVTX for molnex's src/molix/op and for Atomiverse's CUDA
    // paths. cudaVersion/cudnnVersion are deliberately left at the feature's
    // defaults: pinning them here means this file has to be edited every time
    // the feature's accepted-version enum moves.
    "ghcr.io/devcontainers/features/nvidia-cuda:1": {
      "installToolkit": true,
      "installCudnn": true,
      "installNvtx": true
    },

    "ghcr.io/molcrafts/devcontainers/python:1": {
      "pythonVersion": "3.14",
      "tools": "ruff,ty,prek"
    },
    "ghcr.io/molcrafts/devcontainers/rust:1": {},
    "ghcr.io/molcrafts/devcontainers/node:1": {},
    "ghcr.io/molcrafts/devcontainers/native:1": {},

    // 'auto' rather than a hardcoded cuXXX: one image serves GPU hosts and the
    // laptop that opens the same repo, and uv picks the index from the driver
    // it actually finds at resolve time.
    "ghcr.io/molcrafts/devcontainers/torch:1": {
      "backend": "auto",
      "buildIsolation": false
    }
  },

  // 'optional' lets the CLI pass --gpus all when a GPU is present and still
  // open the container when it is not. Hardcoding runArgs made this image
  // unopenable on any machine without the NVIDIA runtime.
  "hostRequirements": {
    "gpu": "optional"
  },

  "mounts": [
    "source=molcrafts-uv-cache,target=/home/vscode/.cache/uv,type=volume",
    "source=molcrafts-cargo-registry,target=/home/vscode/.cargo/registry,type=volume",
    "source=molcrafts-npm-cache,target=/home/vscode/.npm,type=volume"
  ],

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.makefile-tools",
        "redhat.vscode-yaml",
        "GitHub.vscode-github-actions",
        "nvidia.nsight-vscode-edition"
      ],
      "settings": {
        "files.insertFinalNewline": true,
        "files.trimTrailingWhitespace": true,
        "editor.formatOnSave": true,
        "terminal.integrated.defaultProfile.linux": "zsh"
      }
    }
  },

  "remoteUser": "vscode"
}
